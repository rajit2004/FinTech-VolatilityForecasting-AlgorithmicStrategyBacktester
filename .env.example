# Copy this file to .env and fill in your own values.
# The .env file is gitignored, so your secrets stay local.

# Tickers to download from Yahoo Finance by default.
# Put a comma separated list. Both stocks and crypto symbols work.
SYMBOLS=AAPL,MSFT,BTC-USD

# Date range for the historical data downloads.
START_DATE=2021-01-01
END_DATE=2024-12-31

# PostgreSQL connection string understood by SQLAlchemy.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Create a database and a user for the project, then put the details here.
DATABASE_URL=postgresql+psycopg://volforecaster:CHANGE_ME@localhost:5432/volforecaster

# Logging level: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# If no live API key is provided, the fetcher falls back to the bundled CSV
# files inside the dataset folder. These keys are placeholders, keep them
# blank unless you have real keys.
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=

# Model settings. Tweak these to change the LSTM training time and accuracy.
# horizon_days is the number of days ahead we forecast volatility for.
LSTM_SEQUENCE_LENGTH=30
LSTM_EPOCHS=25
FORECAST_HORIZON_DAYS=5
